# 복사 후 .env 로 저장해 사용하세요.

NODE_ENV=development
PORT=8080

# CORS (프론트를 다른 포트에서 띄울 때만 필요)
FRONTEND_ORIGIN=http://127.0.0.1:5500

# KSNET 콜백 URL (server.js 가 POST 전달)
KSNET_API_BASE_URL=https://kswalletdev.ksnet.co.kr
KSNET_API_PATH=/kapi/ksnetApiCallback.do

KSNET_LWRN_USNS_CD=
KSNET_MERCH_NO=
KSNET_MPAY_MSALT=
KSNET_SVC_TKN=
KSNET_MPAY_SGNT_VL=

KSNET_TOKEN_VERIFY_TR_CD=S0KSCCOB01I401

SESSION_SECRET=dev-only-replace-in-production

# 행정안전부 도로명주소 — jusoPopup.jsp 의 confmKey(승인키). 발급 또는 KSNET 샘플 키를 .env 에만 기입
JUSO_CONFM_KEY="U01TX0FVVEgyMDI2MDMxMTExMTgzNjExNzcxNDM="

# 연동 URL: 미설정 시 모바일 addrMobileLinkUrl.do
# PC 웹만 쓸 때: JUSO_LINK_MODE=pc → addrLinkUrl.do
# 또는 전체 URL 직접: JUSO_ADDR_LINK=https://business.juso.go.kr/addrlink/addrLinkUrl.do
# JUSO_LINK_MODE=mobile
# JUSO_RESULT_TYPE=4
